# Root environment example — copy to .env for local development.
# PostgreSQL connection used by the Express API and Prisma.
# Local Docker/Postgres default. In production, use a Supabase session pooler
# string (port 5432) instead; see the Deployment section of README.md.
DATABASE_URL="postgresql://susmeter:susmeter@localhost:5432/susmeter?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Ports
API_PORT="4000"
# Used by scripts/dev_ml.py; keep it in sync with ML_SERVICE_URL below.
ML_PORT="8000"
WEB_PORT="5173"

# Browser-facing API URL (leave empty to use same-origin /api proxy in dev).
VITE_API_URL=""

# Server-to-server URL for the Python ML service.
ML_SERVICE_URL="http://localhost:8000"
