# Python FastAPI ML service — local development environment.
# Copy to apps/ml/.env if you want ML-specific overrides.
# The root .env is also read by scripts/dev_ml.py for ML_PORT.

# Comma-separated origins allowed to call the ML service directly.
# In production the API calls server-to-server, so Render uses '*'.
CORS_ORIGINS="http://localhost:5173,http://localhost:4000"

# Port used by scripts/dev_ml.py. On Render, PORT is injected instead.
ML_PORT="8000"

PYTHONUNBUFFERED="1"
